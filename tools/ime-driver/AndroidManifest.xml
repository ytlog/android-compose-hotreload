<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.compose.hotreload.ime">
    <application android:label="Hot reload verification IME" android:debuggable="true">
        <service android:name=".VerificationIme" android:exported="true" android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
